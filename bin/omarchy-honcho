#!/usr/bin/env bash
# Reports whether a local Honcho instance is reachable. Read-only: makes one
# loopback-only GET request and never writes anything.
#
# Usage: omarchy-honcho status
#   Prints two lines:
#     1. Raw JSON from Honcho's GET /health (or {"status":"unreachable"} if
#        the request fails within the timeout).
#     2. The base URL that was queried, so the panel can display it.
set -uo pipefail

url="${OMARCHY_HONCHO_URL:-http://localhost:8000}"

# Captured via command substitution (which strips any trailing newline the
# server did or didn't send) so the printf below always emits exactly one
# newline between the JSON and the URL line, regardless of the response.
if command -v curl >/dev/null 2>&1; then
  body="$(curl -fsS --max-time 2 "$url/health" 2>/dev/null)" || body='{"status":"unreachable"}'
else
  body='{"status":"unreachable"}'
fi

printf '%s\n%s\n' "$body" "$url"
